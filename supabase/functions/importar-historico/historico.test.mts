import assert from "node:assert/strict";
import { dataDaAba, data, hora, escolherAbas, normalizarAba, sugerirMotorista, chaveNome } from "./historico.ts";
assert.equal(dataDaAba("2506"), "2026-06-25");
assert.equal(dataDaAba("010826"), "2026-08-01");
assert.equal(dataDaAba("05082026"), "2026-08-05");
assert.equal(dataDaAba("11092025"), "2026-09-11");
assert.equal(dataDaAba("28092026."), "2026-09-28");
assert.equal(dataDaAba("27/10/2026"), "2026-10-27");
assert.equal(dataDaAba("Valmor"), null);
assert.equal(dataDaAba("3102"), null);
assert.equal(data(46198), "2026-06-25");
assert.equal(data("2026-06-25 00:00:00"), "2026-06-25");
assert.equal(data(6985915), null);
assert.equal(hora(0.4819), "11:34");
assert.equal(hora("17:15:00"), "17:15");
assert.equal(hora(null), null);
assert.equal(hora(4.673611111111111), "16:10");
assert.equal(data("2026-00-03"), null);
const abas = [{ nome: "28092026.", linhas: [[], []] }, { nome: "28092026", linhas: [[]] }, { nome: "AUX COM", linhas: [] }];
const e = escolherAbas(abas as never);
assert.equal(e.porDia.get("2026-09-28")!.nome, "28092026.");
assert.equal(e.ignoradas.length, 1);
const linha = (p: string, st: string, extra: Record<number, unknown> = {}) => { const l: (string | number | null)[] = Array(23).fill(null); l[0] = p; l[18] = st; for (const [k, v] of Object.entries(extra)) l[+k] = v as never; return l; };
const n = normalizarAba({ nome: "x", linhas: [linha("TOR-2D20", "cumprindo jornada", { 2: "4° SD", 4: 46198, 5: 46198, 6: 0.4819, 7: 46198, 8: 0.7542, 10: "AGUARDANDO X", 22: "A DEFINIR RJ" }), linha("TOR2D20", "DSR"), linha("ABC", "DSR"), linha("QRL7I54", ""), linha("QRL7I54", "AG. CARREG")] }, "2026-06-25");
assert.equal(n.registros.length, 2); assert.equal(n.semStatus, 1);
assert.equal(n.registros[0].status, "PERNOITE"); assert.equal(n.registros[0].tipo, "4º SD");
assert.equal(n.registros[0].cheg_carga, "2026-06-25T11:34:00-03:00"); assert.equal(n.registros[0].embarcador, null);
assert.equal(n.registros[0].proxima_regiao, "RJ"); assert.equal(n.registros[1].status, "AG. CARREGAMENTO");
const ex = [{ id: 1, nome: "ADÃO" }, { id: 4, nome: "JOSÉ ANTONIO" }, { id: 5, nome: "LEONARDO SANTOS" }, { id: 17, nome: "CARLOS" }, { id: 23, nome: "ALESSANDRO" }, { id: 11, nome: "MOISES" }];
assert.equal(sugerirMotorista("Adao", ex).id, 1);
assert.equal(sugerirMotorista("JOSE ANTINIO", ex).id, 4);
assert.equal(sugerirMotorista("ALSESSANDRO", ex).id, 23);
assert.equal(sugerirMotorista("MOISÉS", ex).id, 11);
assert.equal(sugerirMotorista("LEONARDO", ex).id, 5);
assert.equal(sugerirMotorista("LUCIANO TOSTA- MARCOS", ex).nome_novo, "LUCIANO TOSTA- MARCOS".split("- ")[0].trim() === "LUCIANO TOSTA" ? "LUCIANO TOSTA" : "?");
assert.equal(sugerirMotorista("TIAGO RANGEL", ex).motivo, "novo");
assert.equal(chaveNome("MARCOS VINICIUS - EDMILSON"), "MARCOS VINICIUS");
console.log("historico: ok");
