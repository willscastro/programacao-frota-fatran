# Copie este arquivo para ".env" no servidor e preencha. NUNCA coloque o .env no GitHub.

# Endereço (sem https://) que aponta para o IP do servidor. Ex.: zap.suaempresa.com.br
DOMINIO=

# Chave de administração do servidor. Gere com:  openssl rand -hex 32
EVOLUTION_APIKEY=

# Senha do banco interno. Gere com:  openssl rand -hex 16
POSTGRES_SENHA=

# Versão da imagem. Comece com a padrão; depois de validar, FIXE uma versão para atualizações não quebrarem o envio.
EVOLUTION_IMAGE=evoapicloud/evolution-api:latest
